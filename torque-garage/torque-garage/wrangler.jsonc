{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "torque-garage",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vinicar-db",
      "database_id": "b4329dd5-7242-425a-9d6e-13c5deaf4f71"
    }
  ]
}
